   "component": "TogglePassword",
   "property": "font-size",
   "context": "<root>",
   "match": "24px",
   "reason": "This font-size controls the inherited icon SVG geometry, not readable text.",
   "evidence": "TogglePassword renders only the Eye and EyeSlash icons from react-bootstrap-icons; the span carries no readable text, so the 24px sizes the glyph."
  },
