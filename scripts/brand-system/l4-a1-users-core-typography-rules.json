   "component": "VerifiedItem",
   "property": "font-size",
   "context": "svg",
   "match": "12px",
   "reason": "This font-size controls the inherited icon SVG geometry, not readable text.",
   "evidence": "VerifiedItem scopes the declaration to its svg; the badge label text is governed separately by the reviewed root declaration."
  },
  {
   "id": "a1-pres-userdetails-actionselectorwrapper-button-svg-20px",
