  "preservations": [
    {
      "id": "messages-order-identifier-role",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/Messages/styles.js",
      "component": "OrderNumber",
      "property": "font-size",
      "context": ".order-identifier",
      "match": "var(--od-type-identifier-size)",
      "reason": "Only the order or external ID consumes the central identifier role.",
      "evidence": "The translated label remains content-direction text while the nested identifier is isolated in mono and LTR."
    },
    {
      "id": "meta-key-identifier-role",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderMetaFields/styles.js",
      "component": "IdentifierBorder",
      "property": "font-size",
      "context": "<root>",
      "match": "var(--od-type-identifier-size)",
      "reason": "Only the machine-facing meta-field key consumes the central identifier role.",
      "evidence": "Arbitrary meta-field values remain content typography and inherit the document writing direction."
    },
    {
      "id": "messages-empty-svg-geometry",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/Messages/styles.js",
      "component": "NotSendMessage",
      "property": "font-size",
      "context": "svg",
      "match": "20px",
      "reason": "This font-size controls the empty-state SVG geometry, not readable text.",
      "evidence": "NotSendMessage scopes the declaration to svg while its paragraph uses the central content role."
    },
    {
      "id": "messages-send-svg-geometry",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/Messages/styles.js",
      "component": "SendImage",
      "property": "font-size",
      "context": "svg",
      "match": "20px",
      "reason": "This font-size controls the attachment SVG geometry, not readable text.",
      "evidence": "SendImage scopes the declaration to svg and exposes the upload action through separate semantics."
    },
    {
      "id": "messages-detail-svg-geometry",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/Messages/styles.js",
      "component": "OrderDetailIconButton",
      "property": "font-size",
      "context": "svg",
      "match": "30px",
      "reason": "This font-size controls the order-detail SVG geometry, not readable text.",
      "evidence": "OrderDetailIconButton contains an icon-only action with a separate accessible name."
    },
    {
      "id": "meta-delete-svg-geometry",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderMetaFields/styles.js",
      "component": "MetaContainer",
      "property": "font-size",
      "context": ".meta_value > svg",
      "match": "20px",
      "reason": "This font-size controls the delete SVG geometry, not readable text.",
      "evidence": "MetaContainer scopes the declaration to the icon while the delete action is named by its button owner."
    }
  ]
