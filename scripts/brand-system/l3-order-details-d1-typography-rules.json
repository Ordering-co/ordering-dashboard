    { "id": "order-details-button-link-svg-geometry", "kind": "static-declaration", "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderDetails/styles.js", "component": "ButtonLink", "property": "font-size", "context": "svg", "match": "24px", "reason": "This font-size controls the inherited action SVG geometry, not readable text.", "evidence": "ButtonLink scopes the value to svg while its accessible action text is supplied by the surrounding control contract." },
