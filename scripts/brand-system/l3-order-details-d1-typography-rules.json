    { "id": "clone-order-option-control-role", "kind": "static-declaration", "file": "src/@/components-dashboard/src/ui/src/components/Orders/CloneOrder/styles.js", "component": "CloneOption", "property": "font-size", "context": "span", "match": "var(--od-type-control-size)", "reason": "This newly introduced choice label already consumes the central control role.", "evidence": "CloneOption keeps the SVG geometry separate while its readable span follows control-size propagation." },
