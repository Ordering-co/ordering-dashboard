    {
      "id": "a3-settings-places-pres-multicountrysettings-siteitem-root-inherit-9fdab3",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Settings/MultiCountrySettings/styles.js",
      "component": "SiteItem",
      "property": "font-size",
      "context": "<root>",
      "match": "inherit",
      "reason": "This declaration declares no size of its own: it is the `font-size: inherit` of an accessibility conversion's reset. A `<button>` does NOT inherit its container's font size; it adopts the user agent's. Without this line the converted node detaches from the size its parent receives from the system, which is Z3 of the deferred wave, open against EVERY conversion L5 made.",
      "evidence": "SiteItem de MultiCountrySettings pasa de `styled.div` a `styled.button.attrs({ type: 'button' })`, como los tres de a2."
    },
