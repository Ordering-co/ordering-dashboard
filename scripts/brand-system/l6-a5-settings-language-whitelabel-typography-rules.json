  "preservations": [
    {
      "id": "a5-settings-language-whitelabel-pres-languagemanager-viewiconwrapper-svg-16px-ed5967",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Settings/LanguageManager/styles.js",
      "component": "ViewIconWrapper",
      "property": "font-size",
      "context": "> svg",
      "match": "16px",
      "reason": "Este font-size dimensiona un glifo de icono, no texto legible. Los siete roles son roles de TEXTO.",
      "evidence": "ViewIconWrapper > svg: los glifos de los iconos de vista lista/tabla."
    },
    {
      "id": "a5-settings-language-whitelabel-pres-languagemanager-selectcontent-p-14px-6b2fb7",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Settings/LanguageManager/styles.js",
      "component": "SelectContent",
      "property": "font-size",
      "context": "p",
      "match": "14px",
      "reason": "This declaration matches no node in the component's current markup: the selector reaches nothing that the product renders, so asserting a role over it would be asserting something unprovable.",
      "evidence": "SelectContent p: ningun <p> existe en la cadena del Select (LegacySelect, SearchBar, Pagination: cero etiquetas <p>)."
    },
    {
      "id": "a5-settings-language-whitelabel-pres-languagesetting-fieldcontainer-default-s-3b6e77",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Settings/LanguageSetting/styles.js",
      "component": "FieldContainer",
      "property": "font-size",
      "context": ".default > svg",
      "match": "20px",
      "reason": "Este font-size dimensiona un glifo de icono, no texto legible. Los siete roles son roles de TEXTO.",
      "evidence": "FieldContainer .default > svg: los glifos Circle/RecordCircle del radio."
    },
    {
      "id": "a5-settings-language-whitelabel-pres-languagesetting-radiowrapper-root-inherit",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Settings/LanguageSetting/styles.js",
      "component": "RadioWrapper",
      "property": "font",
      "context": "<root>",
      "match": "inherit",
      "reason": "This native button inherits the surrounding typography instead of declaring a local size; it only wraps the radio icon glyph, not readable text. Any change to the component, value, context or cardinality reopens classification.",
      "evidence": "Bugs H R1-02: the Default mark RadioWrapper became a native button; `font: inherit` only resets the user-agent button font and adds no size."
    },
    {
      "id": "a5-settings-language-whitelabel-pres-cms-emptymessage-root-content-role",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Settings/Cms/styles.js",
      "component": "EmptyMessage",
      "property": "font-size",
      "context": "<root>",
      "match": "var(--od-type-content-size)",
      "reason": "The empty-list message is readable body text and already consumes the central content role.",
      "evidence": ": EmptyMessage is a new <p> that names an empty pages list; it declares only var(--od-type-content-size) and no literal size."
    }
  ]
