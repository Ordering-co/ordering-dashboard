  "preservations": [
    {
      "id": "a1-campaigns-pres-campaignamountoption-arrowiconswrapper-svg-12px",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Marketing/CampaignAmountOption/styles.js",
      "component": "ArrowIconsWrapper",
      "property": "font-size",
      "context": "svg",
      "match": "12px",
      "reason": "This font-size sizes an icon glyph, not readable text; any change to the component, value, context or cardinality reopens classification.",
      "evidence": "ArrowIconsWrapper svg: the up/down arrow glyphs of the amount stepper."
    },
    {
      "id": "a1-campaigns-pres-campaigndetail-actionselectorwrapper-button-svg-20px",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Marketing/CampaignDetail/styles.js",
      "component": "ActionSelectorWrapper",
      "property": "font-size",
      "context": "button > svg",
      "match": "20px",
      "reason": "This font-size sizes an icon glyph, not readable text; any change to the component, value, context or cardinality reopens classification.",
      "evidence": "ActionSelectorWrapper button > svg: the kebab action-menu glyph."
    },
    {
      "id": "a1-campaigns-pres-campaignemail-emailpreviewcontent-h2-14px",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Marketing/CampaignEmail/styles.js",
      "component": "EmailPreviewContent",
      "property": "font-size",
      "context": "> h2",
      "match": "14px",
      "reason": "This font-size belongs to a facsimile of the message the recipient receives, not to the dashboard interface; migrating it would misrepresent what the campaign will actually send.",
      "evidence": "EmailPreviewContent > h2 renders contact_data.title, the subject line of the email that will be sent."
    },
    {
      "id": "a1-campaigns-pres-campaignemail-emailpreviewcontent-p-12px",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Marketing/CampaignEmail/styles.js",
      "component": "EmailPreviewContent",
      "property": "font-size",
      "context": "p",
      "match": "12px",
      "reason": "This font-size belongs to a facsimile of the message the recipient receives, not to the dashboard interface; migrating it would misrepresent what the campaign will actually send.",
      "evidence": "EmailPreviewContent p styles the paragraphs of contact_data.body, injected through dangerouslySetInnerHTML: it is the author's email copy, not dashboard text."
    },
    {
      "id": "a1-campaigns-pres-campaignemail-wrappereditor-note-editor-note-dropdown-menu-h1-36px",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Marketing/CampaignEmail/styles.js",
      "component": "WrapperEditor",
      "property": "font-size",
      "context": ".note-editor > .note-dropdown-menu > h1",
      "match": "36px",
      "reason": "This font-size is the summernote editor's own sample of a text format, shown so the author can see what the format looks like; it is authored-content styling, not interface typography.",
      "evidence": "The declaration lives under .note-editor > .note-dropdown-menu inside WrapperEditor, which is the third-party editor's format menu."
    },
    {
      "id": "a1-campaigns-pres-campaignnotification-smspreviewcontent-h2-10px",
