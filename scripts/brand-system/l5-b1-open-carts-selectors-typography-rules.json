  "preservations": [
    {
      "id": "b1-open-carts-selectors-pres-productitemaccordion-contentinfo-span-p-14px-d4cf50",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/CartRecovery/ProductItemAccordion/styles.js",
      "component": "ContentInfo",
      "property": "font-size",
      "context": "span > p",
      "match": "14px",
      "reason": "This selector matches no node in the component's current markup, so assigning it a typographic role would publish a claim no fixture can demonstrate; it is preserved and named as debt instead.",
      "evidence": "ContentInfo renders a div holding an h3 and an optional p; there is no direct span child, so `span > p` matches nothing."
    },
    {
      "id": "b1-open-carts-selectors-pres-productitemaccordion-contentinfo-span-div-span-s-101fa8",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/CartRecovery/ProductItemAccordion/styles.js",
      "component": "ContentInfo",
      "property": "font-size",
      "context": "span > div > span > svg",
      "match": "20px",
      "reason": "This font-size sizes an icon glyph, not readable text; any change to the component, value, context or cardinality reopens classification.",
      "evidence": "The quantity/edit glyphs. They also sit inside the same unrendered span as line 124, so this declaration is doubly unreachable; icon-glyph is the narrower and more durable of the two reasons."
    },
    {
      "id": "b1-open-carts-selectors-pres-productitemaccordion-contentinfo-media-min-width-1da243",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/CartRecovery/ProductItemAccordion/styles.js",
      "component": "ContentInfo",
      "property": "font-size",
      "context": "@media (min-width: 577px) > h3",
      "match": "18px",
      "reason": "This declaration is a breakpoint override of an element whose role is already assigned at its base size; the role scale has one size per role and cannot express a per-breakpoint bump, so migrating it would either flatten the responsive behaviour or give one element two roles.",
      "evidence": "The same ContentInfo h3 that takes `content` at line 111 is raised to 18px above 577px. Giving this one sectionTitle would make one heading content on a phone and a section title on a laptop."
    },
    {
      "id": "b1-open-carts-selectors-pres-productitemaccordion-productactionsedit-svg-20px-778e15",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/CartRecovery/ProductItemAccordion/styles.js",
      "component": "ProductActionsEdit",
      "property": "font-size",
      "context": "svg",
      "match": "20px",
      "reason": "This declaration is identical to its already-migrated twin in Orders, which L3 preserved; preserving it here keeps one visual element from carrying two different treatments on two screens.",
      "evidence": "Orders/ProductItemAccordion preserved this same svg declaration at the same value in L3."
    }
  ]
