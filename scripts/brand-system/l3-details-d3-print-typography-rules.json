  "preservations": [
    {
      "id": "product-quantity-identifier-role",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/ProductItemAccordion/styles.js",
      "component": "ProductQuantity",
      "property": "font-size",
      "context": "<root>",
      "match": "var(--od-type-identifier-size)",
      "reason": "The standalone product quantity already consumes the central identifier role.",
      "evidence": "Quantity remains mono and bidi-isolated while its surrounding product label uses content typography."
    },
    {
      "id": "product-action-svg-geometry",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/ProductItemAccordion/styles.js",
      "component": "ProductActionsEdit",
      "property": "font-size",
      "context": "svg",
      "match": "20px",
      "reason": "This font-size controls edit and delete SVG geometry and not readable text.",
      "evidence": "Named Ordering.co IconButton owners provide the action semantics and touch target."
    },
    {
      "id": "normal-print-title-physical",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderToPrint/styles.js",
      "component": "PrintContainer",
      "property": "font-size",
      "context": "> h1",
      "match": "20px",
      "reason": "This fixed print size is part of the established physical invoice layout.",
      "evidence": "Real PDF rendering verifies the title remains legible without changing page breaks or print dimensions."
    },
    {
      "id": "ticket-print-title-physical",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderToPrintTicket/styles.js",
      "component": "PrintContainer",
      "property": "font-size",
      "context": "> h1",
      "match": "20px",
      "reason": "This fixed print size is part of the established thermal-ticket layout.",
      "evidence": "Real PDF rendering verifies the title within the preserved 420px ticket width."
    },
    {
      "id": "ticket-print-copy-physical",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderToPrintTicket/styles.js",
      "component": "PrintTextContainer",
      "property": "font-size",
      "context": "<root>",
      "match": "16px",
      "reason": "This fixed print size preserves thermal-ticket readability.",
      "evidence": "Real PDF rendering verifies long customer data and page flow."
    },
    {
      "id": "ticket-print-comments-physical",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderToPrintTicket/styles.js",
      "component": "ProdcutCommentsContainer",
      "property": "font-size",
      "context": "<root>",
      "match": "16px",
      "reason": "This fixed print size preserves product-option readability on the thermal ticket.",
      "evidence": "Real PDF rendering verifies wrapped options remain with their product."
    },
    {
      "id": "ticket-print-label-physical",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderToPrintTicket/styles.js",
      "component": "InsideInfo",
      "property": "font-size",
      "context": "<root>",
      "match": "16px",
      "reason": "This fixed print size preserves the thermal-ticket label column.",
      "evidence": "Real PDF rendering verifies the 70 percent label and 30 percent value columns."
    },
    {
      "id": "ticket-print-value-physical",
      "kind": "static-declaration",
      "file": "src/@/components-dashboard/src/ui/src/components/Orders/OrderToPrintTicket/styles.js",
      "component": "InsideInfo2",
      "property": "font-size",
      "context": "<root>",
      "match": "16px",
      "reason": "This fixed print size preserves the thermal-ticket value column.",
      "evidence": "Real PDF rendering verifies totals remain legible and aligned."
    }
  ]
}
