VITE_DASHBOARD_UPGRADE_FORM_URL=
VITE_DASHBOARD_UPGRADE_FORM_PREFILL=false

# Optional HTTPS origin authorized to receive sessions during a dashboard migration.
VITE_DASHBOARD_LEGACY_SESSION_ORIGIN=
