# Configure your own services. VITE values are browser-visible.
VITE_OG_TITLE=
VITE_OG_DESCRIPTION=
VITE_OG_URL=
VITE_OG_SITE_NAME=
VITE_OG_IMAGE=
ASSET_BASE_URL=/
VITE_ASSET_BASE_URL=/
VITE_MENU_IMPORT_API_URL=
VITE_SUPABASE_URL=
