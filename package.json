{
  "name": "dashboard",
  "version": "2.0.0",
  "description": "New Ordering Admin",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite --port 3001",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "preview": "vite preview --port 3001",
    "serve": "vite preview --port 3001",
    "prod": "pnpm build && pnpm preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:coverage:summary": "node scripts/coverage-summary.js",
    "palette:coverage": "vitest --run src/@/components-dashboard/src/utils/__tests__/commandPaletteSurfaces.test.js",
    "brand:check": "node scripts/brand-tokens.mjs check",
    "ui:check": "node scripts/ordering-ui.mjs",
    "ui:sync": "node scripts/ordering-ui.mjs --write",
    "brand:freshness": "node scripts/brand-tokens.mjs freshness",
    "brand:sync": "node scripts/brand-tokens.mjs sync",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "i18n:generate": "node i18n/generate.cjs",
    "i18n:verify": "node i18n/verify.cjs",
    "i18n:missing": "node i18n/missing.cjs",
    "i18n:apply-batch": "node i18n/applyBatch.cjs",
    "i18n:sync": "node i18n/sync.cjs --dry-run",
    "i18n:sync:live": "node i18n/sync.cjs --live",
    "prepare": "husky",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "cf:dev": "wrangler dev",
    "i18n:check-generated": "node i18n/check-generated.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ordering-co/ordering-dashboard.git"
  },
  "author": "Ordering",
  "license": "SEE LICENSE IN LICENSE-ORDERING",
  "bugs": {
    "url": "https://github.com/Ordering-co/ordering-dashboard/issues"
  },
  "dependencies": {
    "@base-ui/react": "1.0.0",
    "@handsontable/react": "^9.0.1",
    "@meronex/icons": "^4.0.0",
    "@popperjs/core": "^2.5.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sentry/react": "^7.109.0",
    "@stripe/react-stripe-js": "^2.7.0",
    "@stripe/stripe-js": "^1.54.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "bootstrap": "^4.6.0",
    "chart.js": "^3.5.0",
    "chartjs-adapter-moment": "^1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cropperjs": "^1.5.12",
    "date-fns": "^2.24.0",
    "dayjs": "^1.9.3",
    "decimal.js": "^10.4.3",
    "firebase": "9.15.0",
    "google-map-react": "^2.1.9",
    "handsontable": "^9.0.1",
    "jquery": "^3.6.0",
    "jsoneditor": "^9.3.0",
    "jsoneditor-react": "^3.1.1",
    "libphonenumber-js": "1.11.19",
    "moment": "^2.30.1",
    "payment": "^2.4.7",
    "pdfjs-dist": "6.3.289",
    "polished": "^3.6.7",
    "posthog-js": "^1.170.1",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.4.2",
    "react-bootstrap": "^1.6.0",
