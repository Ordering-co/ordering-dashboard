          "status": "canonical-derivative",
          "asset": "/assets/icons/ordering-apple-touch-icon-180.png",
          "size": 180,
          "background": "#FFFFFF",
          "alpha": false
        },
        "webApp": {
          "manifest": "/manifest.webmanifest",
          "purpose": "any",
          "icons": {
            "192": "/assets/icons/ordering-app-icon-192.png",
            "512": "/assets/icons/ordering-app-icon-512.png"
          },
          "maskable": {
            "status": "not-approved",
            "reason": "The current contained-symbol geometry is not certified for the maskable safe zone; do not declare purpose=maskable."
          }
        }
      },
      "colorBoundary": "The four-color palette remains fixed across Light and Dark and is not an interface state or action palette.",
      "palette": {
        "blue": "#266DF0",
        "green": "#32B45F",
        "orange": "#FF9418",
        "pink": "#E91D63"
      },
      "print": {
        "masterColorSpace": "sRGB",
        "browserPrintProof": "simulation-only",
        "productionFormat": "PDF/X-4",
        "conversionPolicy": "Convert per job with the ICC profile supplied by the printer; no universal CMYK or Pantone values are canonical."
      }
    },
    "voice": {
      "status": "released-public",
      "language": "en-US",
      "model": "seasoned builder",
      "canonicalPage": "/voice",
      "publicationBoundary": "Voice alignment and publication authority are separate gates."
