{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-code-contract.schema.json",
  "title": "Ordering Dashboard source-download API JSON",
  "oneOf": [
    { "$ref": "#/$defs/catalog" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "localizedStrings": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": { "type": "string" }
      },
      "additionalProperties": false
    },
    "submodule": {
      "type": "object",
      "required": ["path", "sha"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$" }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": [
        "id", "name", "descriptionByLocale", "version", "publishedAt", "timezone",
        "sourceSha", "submodules", "license", "instructionsByLocale", "artifact"
      ],
      "properties": {
        "id": { "const": "website-marketplace" },
        "name": { "const": "Website Marketplace" },
        "descriptionByLocale": { "$ref": "#/$defs/localizedStrings" },
        "version": { "type": "string", "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{6}$" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "timezone": { "const": "UTC-06:00" },
        "sourceSha": { "type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$" },
        "submodules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/submodule" }
        },
        "license": {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 120 },
            "text": { "type": "string", "minLength": 1, "maxLength": 65536 }
          },
          "additionalProperties": false
        },
        "instructionsByLocale": { "$ref": "#/$defs/localizedStrings" },
        "artifact": {
          "type": "object",
          "required": ["filename", "sizeBytes", "sha256"],
          "properties": {
            "filename": { "type": "string", "pattern": "^website-marketplace-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{6}\\.zip$" },
            "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": ["schemaVersion", "products"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "products": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/product" }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
